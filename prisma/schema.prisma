generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Товары (цветы) ──
model Flower {
  id          String     @id @default(cuid())
  name        String     // название: "Роза красная", "Тюльпан жёлтый"
  description String?    // описание
  price       Float      // цена продажи за штуку
  costPrice   Float?     // закупочная цена за штуку
  stock       Int        @default(0) // остаток на складе
  imageUrl    String?    // ссылка на фото (optional)
  category    String?    // категория: "розы", "тюльпаны", "сезонные"
  active      Boolean    @default(true) // показывать ли на витрине
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  orderItems    OrderItem[]
  writeOffs     WriteOff[]
  inboundItems  StockInboundItem[]
}

// ── Заказы клиентов ──
model Order {
  id            String   @id @default(cuid())
  clientName    String
  clientPhone   String
  address       String?
  addressLat    Float?
  addressLng    Float?
  deliverySlot  String?
  comment       String?
  source        String   @default("online") // online | walkin
  paymentMethod String?  // terminal | qr | cash
  status        String   @default("new") // new | processing | completed | cancelled
  totalAmount   Float
  bonusSpent    Int      @default(0)
  bonusEarned   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         OrderItem[]
}

// ── Позиции заказа ──
model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  flowerId    String?
  flowerName  String   // имя на момент заказа (денормализация)
  quantity    Int      // количество
  price       Float    // цена за штуку на момент заказа
  subtotal    Float    // сумма строки = quantity * price

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  flower      Flower?  @relation(fields: [flowerId], references: [id], onDelete: SetNull)
}

// ── Списания (админ учитывает испорченные/unsold цветы) ──
model WriteOff {
  id          String   @id @default(cuid())
  flowerId    String?
  flowerName  String   // имя на момент списания
  quantity    Int      // сколько списано
  reason      String?  // причина: "увяли", "повреждены", "просрочка"
  createdAt   DateTime @default(now())

  flower      Flower?  @relation(fields: [flowerId], references: [id], onDelete: SetNull)
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model ShopSetting {
  key   String @id
  value String
}

model CustomerBonus {
  phone     String   @id
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ── Приход на склад (накладная / ручной ввод) ──
model StockInbound {
  id        String   @id @default(cuid())
  fileName  String?
  note      String?
  createdAt DateTime @default(now())

  items     StockInboundItem[]
}

model StockInboundItem {
  id         String   @id @default(cuid())
  inboundId  String
  flowerId   String?
  flowerName String
  quantity   Int
  costPrice  Float?  // закупочная цена на момент прихода

  inbound    StockInbound @relation(fields: [inboundId], references: [id], onDelete: Cascade)
  flower     Flower?      @relation(fields: [flowerId], references: [id], onDelete: SetNull)
}
